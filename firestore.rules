rules_version = '2';

// VTWork Firestore 보안 규칙
//
// 배경:
//   이전 규칙은 `allow read, write: if request.auth != null` 이었다.
//   즉 "로그인한 사용자면 누구나 전부"였는데, Firebase Authentication 의
//   신규 가입이 열려 있어서 배포된 JS 에 들어있는 API 키만으로 누구나
//   계정을 만들 수 있었다. 그렇게 만든 계정으로 학생 실명·연락처·결제내역·
//   영수증 이미지를 전부 읽고 쓸 수 있는 상태였다.
//
// 방침:
//   이 앱은 학원 운영자 본인만 쓰는 내부 도구이므로, 허용된 UID 목록에
//   있는 계정만 접근할 수 있게 한다. 가입이 열려 있더라도 새로 만든
//   계정은 아무것도 할 수 없다.
//
// 계정을 추가하려면:
//   1) Firebase 콘솔 → Authentication → 사용자 추가
//   2) 생성된 UID 를 아래 목록에 추가 (주석으로 이메일도 함께)
//   3) 규칙 재배포 (node scripts/deploy-rules.js key-A.json)
//
// 목록 확인: node scripts/list-auth-users.js key-A.json

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
          && request.auth.uid in [
               // ── 운영 (vt-schedule-12568)
               'xA6nm0L4uBTyRBctRRNqzKND1oW2',  // voicetuning@nate.com
               // ── 개발 (vt-work-dev-eeeaa)
               'dLFgRjqJIzOdBjFBcozMvB36uAx1'   // wlusa2@nate.com
             ];
    }

    // ── 매니지먼트(아티스트) 전용 — 2026-10-10 추가
    //
    //   artists            아티스트 일반정보 + 정산비율
    //   artistPrivate      민감정보(생년월일·주소·계좌). 문서 ID 는 artists 와 동일
    //   mgmtCategories     공통 수익·지출 항목
    //   artistLedger       아티스트별 수입·지출 장부
    //   artistCases        별도정산 건 (2026-10-10 2단계 추가)
    //   artistSettlements  (다음 단계) 정산 결과
    //
    // 아티스트 개인정보·계약·정산이 들어가므로 원장(허용 UID) 전용이다.
    // ⚠️ 솔직히 적어두면: 아래 /{document=**} 규칙이 이미 '허용 UID 외 전부 차단' 이라
    //    이 블록은 기능상 새 제한이 아니고 '의도를 명시' 하는 것이다. Firestore 규칙은
    //    여러 match 가 OR 로 합쳐지므로, 여기에 적어도 기존 규칙이 느슨해지지는 않는다.
    //    나중에 원장 외 계정(예: 아티스트 본인 열람)을 허용할 때 여기만 고치면 된다.
    match /artists/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /artistPrivate/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /mgmtCategories/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /artistLedger/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /artistCases/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /artistSettlements/{docId} {
      allow read, write: if isAllowedUser();
    }

    // 이 앱의 모든 데이터(students, schedules, attendance, expenses,
    // weekly_memos/locks, settlement_memos, site_settings,
    // schedule_cancellations, students/*/payments)는 운영자 전용이다.
    match /{document=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
